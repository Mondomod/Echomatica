@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<>
	a pset:Preset ;
	lv2:appliesTo <urn:hvcc:Echomatica> ;
	rdfs:label "Midnight" ;
	lv2:port [
		lv2:symbol "dry" ;
		pset:value 1.0
	] , [
		lv2:symbol "echo" ;
		pset:value 0.26339301
	] , [
		lv2:symbol "fdbck_mode" ;
		pset:value 0.0
	] , [
		lv2:symbol "feedback" ;
		pset:value 0.36272299
	] , [
		lv2:symbol "tapehead_mode" ;
		pset:value 8.0
	] , [
		lv2:symbol "varispeed" ;
		pset:value 0.29464301
	] , [
		lv2:symbol "varispeed_enable" ;
		pset:value 0.0
	] .

