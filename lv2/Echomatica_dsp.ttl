@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix dg:    <http://www.darkglass.com/lv2/ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .

<urn:hvcc:Echomatica>
    a lv2:Plugin, lv2:DelayPlugin, doap:Project;

    lv2:extensionData opts:interface ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 4 ;
        lv2:name "Events Input" ;
        lv2:symbol "lv2_events_in" ;
        rsz:minimumSize 2048 ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "dry" ;
        lv2:symbol "dry" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "echo" ;
        lv2:symbol "echo" ;
        lv2:default 0.5 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:name "feedback mode" ;
        lv2:symbol "fdbck_mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:enumeration, lv2:integer;
        lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "Feedback x1" ;
            rdfs:comment "Echo" ;
        ], [
            rdf:value 1 ;
            rdfs:label "Stereo Modulation" ;
            rdfs:comment "Halo" ;
        ], [
            rdf:value 2 ;
            rdfs:label "Mod+Feedback x3" ;
            rdfs:comment "Reverb" ;
        ];
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:name "feedback" ;
        lv2:symbol "feedback" ;
        lv2:default 0.5 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:name "tapehead mode" ;
        lv2:symbol "tapehead_mode" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
         lv2:portProperty lv2:enumeration, lv2:integer;
        lv2:scalePoint [
            rdfs:label  "Echomatic 1 F  - Mode A" ;
            rdf:value 0 ;
        ] ,
        [
            rdfs:label  "Echomatic 1 F - Mode B" ;
            rdf:value 1 ;
        ] ,
        [
            rdfs:label  "Echomatic 1 F - Mode C" ;
            rdf:value 2 ;
        ] ,
        [
            rdfs:label  "Echomatic 1 F - Mode D" ;
            rdf:value 3 ;
        ] ,
        [
            rdfs:label  "Echomatic 1 F  - Mode E" ;
            rdf:value 4 ;
        ] ,
        [
            rdfs:label  "Echomatic 1 F - Mode F" ;
            rdf:value 5 ;
        ] ,
        [
            rdfs:label  "Echomatic 2 - Mode A" ;
            rdf:value 6 ;
        ] ,
	 [
            rdfs:label  "Echomatic 2 - Mode B" ;
            rdf:value 7 ;
        ] ,
 	 [
            rdfs:label  "Echomatic 2 - Mode C" ;
            rdf:value 8 ;
        ] ,
        [
            rdfs:label  "Echomatic 1 J  - Mode A" ;
            rdf:value 9 ;
        ] ,
		     [
            rdfs:label  "Echomatic 1 F  - Mode B" ;
            rdf:value 10 ;
        ] ,
        [
            rdfs:label  "PA 304 - Mode A" ;
            rdf:value 11 ;
        ] ,
        [
            rdfs:label  "PA 304 - Mode B" ;
            rdf:value 12 ;
        ] ,
        [
            rdfs:label  "PA 304 - Mode C" ;
            rdf:value 13 ;
        ] ,
		[
            rdfs:label  "PA 304 - Mode E" ;
            rdf:value 14 ;
        ] ,
		[
            rdfs:label  "PA 304 - Mode F" ;
            rdf:value 15 ;
        ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:name "varispeed" ;
        lv2:symbol "varispeed" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:name "varispeed enable" ;
        lv2:symbol "varispeed_enable" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ;

    rdfs:comment "Modeled after the Italian multi-head magnetic tape and drum delays designed by Societa Elletronica Palomba are were licensed under the name Meazzi, Framez, and Vox in the late 50's and early 60's.  Specifically the Echomatic 1 'Framez' badged five-head, 'Jennings' badged six-head and the Echomatic 2 four-head drum delay, along with the PA 304 five-head tape delay.   Note that  the Echo/Halo/Reverb settings are not representative of the originals but equate to normal-feedback/modulated-stereo-feedback/modulated-increased-feedback." ;

    mod:brand "Mondomatic" ;
    mod:label "Echomatica" ;

    doap:name "Echomatica" ;
    doap:license <http://spdx.org/licenses/ISC.html> ;

    doap:maintainer [
		foaf:name "Jim Auge'" ;
		foaf:homepage <https://websites.umich.edu/~jauge/echomatica/> ;		
    ] ;

    lv2:microVersion 5 ;
    lv2:minorVersion 1 .
	
